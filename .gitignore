/target
**/*.rs.bk
*.pdb

# Never commit key material or live node state, even from a scratch test run.
*.keystore
# The name a node actually uses. `*.keystore` above never matched it, so a
# scratch node created inside the checkout would have been committable.
keystore.bin
*.redb
*.itsanas-key
# The Android release key and the file naming it. Whoever holds these controls
# every future update of the published application, and Google will not re-key
# a listing, so they are Nicolas's to generate, hold and back up -- never the
# repository's and never an agent's.
*.jks
android/keystore.properties
/testdata/
/.itsanas/

# Python bytecode from the CI check scripts.
__pycache__/

# Android build outputs, and the native libraries built into the app by
# `scripts/build-apk.sh`. The libraries are a build product of `crates/`, not a
# source: committing them would put three architectures of the same code in
# every clone and let them drift from the Rust that produced them.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/jniLibs/
android/.kotlin/
