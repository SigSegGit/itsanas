<?xml version="1.0" encoding="utf-8"?>
<!-- Clear text for 127.0.0.1 alone: the page the engine serves to this
     application's own web view, on a port of its own and behind a key. Every
     other address needs TLS, as the platform's default says. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
