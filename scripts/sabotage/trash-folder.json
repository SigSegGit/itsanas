{
  "command": [
    "cargo",
    "test",
    "-p",
    "itsanas-folder",
    "--test",
    "folder"
  ],
  "defences": {
    "folder: a delete is written at once": {
      "file": "crates/itsanas-folder/src/lib.rs",
      "live": "            deletion::Mode::Trash | deletion::Mode::Direct => {\n                deletion::trash_shared(store, path, now, rules.days)?;",
      "dead": "            deletion::Mode::Trash | deletion::Mode::Direct => {\n                store.remove_file(path)?;"
    },
    "folder: a file put back stays in the trash": {
      "file": "crates/itsanas-folder/src/lib.rs",
      "live": "        deletion::restore_shared_known(store, path)?;\n        Self::put_back(store, path)?;",
      "dead": "        Self::put_back(store, path)?;"
    },
    "folder: a renamed file's old name stays in the trash": {
      "file": "crates/itsanas-folder/src/lib.rs",
      "live": "                deletion::restore_shared_known(store, from)?;\n                freed::take_out(store.root(), from)",
      "dead": "                freed::take_out(store.root(), from)"
    }
  }
}
