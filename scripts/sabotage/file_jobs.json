{
  "command": [
    "cargo",
    "test",
    "-p",
    "itsanas-cli",
    "--lib",
    "while_the_"
  ],
  "defences": {
    "jobs: the daemon refuses file jobs": {
      "file": "crates/itsanas-cli/src/daemon.rs",
      "live": "        | Kind::Free { .. } => crate::file_job(node, &job),\n",
      "dead": "        | Kind::Free { .. } => Err(\"refused\".to_owned()),\n"
    },
    "jobs: the conversion is done at once and nothing converted": {
      "file": "crates/itsanas-cli/src/daemon.rs",
      "live": "            eprintln!(\"itsanas: converting to pack files; this run stops for it\");\n",
      "dead": "            jobs::report(&node.home, job.id, State::Done, \"converted\");\n            return;\n"
    }
  }
}
