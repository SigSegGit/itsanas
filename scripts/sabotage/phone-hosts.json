{
  "command": [
    "cargo",
    "test",
    "-p",
    "itsanas-cli",
    "--lib",
    "host_run"
  ],
  "defences": {
    "hosts: not a withdrawn device": {
      "file": "crates/itsanas-coord/src/service.rs",
      "live": "if claim.claim.revoked
                || claim.claim.pledged_bytes == 0",
      "dead": "if claim.claim.pledged_bytes == 0"
    },
    "hosts: not one offering nothing": {
      "file": "crates/itsanas-coord/src/service.rs",
      "live": "                || claim.claim.pledged_bytes == 0\n",
      "dead": ""
    },
    "hosts: not the asker's own": {
      "file": "crates/itsanas-coord/src/service.rs",
      "live": "                || claim.claim.owner == mine.claim.owner\n",
      "dead": ""
    },
    "hosts: nothing private": {
      "file": "crates/itsanas-node/src/coordinator.rs",
      "live": "                && dialable_from_anywhere(&row.presence.presence.address)\n",
      "dead": ""
    },
    "hosting: the loop starts": {
      "file": "crates/itsanas-cli/src/host_run.rs",
      "live": "if let Some(every) = plan.every.filter(|_| plan.work != HostWork::Nothing) {",
      "dead": "if let Some(every) = plan.every.filter(|_| false) {"
    },
    "hosting: on battery it takes in nothing": {
      "file": "crates/itsanas-cli/src/daemon.rs",
      "live": "if answers_only.load(Ordering::Relaxed) || !vault_present(&vault) {",
      "dead": "if !vault_present(&vault) {"
    },
    "hosting: signing out ends the loop": {
      "file": "crates/itsanas-cli/src/account.rs",
      "live": "    // an account that has left this phone.\n    crate::host_run::stop_current();",
      "dead": "    // an account that has left this phone."
    }
  }
}
