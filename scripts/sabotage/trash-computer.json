{
  "command": [
    "cargo",
    "test",
    "-p",
    "itsanas-cli",
    "--lib",
    "trash"
  ],
  "defences": {
    "trash: a delete by default is written at once": {
      "file": "crates/itsanas-store/src/trash.rs",
      "live": "    crate::deletion::trash_shared(store, path, now, rules.days)?;\n    store.flush_segment()?;\n    Ok(Deleted::Trashed)",
      "dead": "    crate::remove_known(store, vault, path)?;\n    store.flush_segment()?;\n    Ok(Deleted::Trashed)"
    },
    "page: the trash deletes a file nobody trashed": {
      "file": "crates/itsanas-cli/src/deleting.rs",
      "live": "    if let Some(stray) = paths.iter().find(|path| !inside.contains(path)) {",
      "dead": "    if let Some(stray) = paths.iter().find(|path| path.is_empty() && !inside.contains(path)) {"
    }
  }
}
